datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

//---------- Catalogos ----------
model estados {
  id          Int    @id @default(autoincrement())
  clave       Int    @unique
  nombre      String @unique
  abreviatura String

  // Relaciones -----
  municipios municipios[]
}

model municipios {
  id        Int    @id @default(autoincrement())
  estado_id Int
  clave     Int
  nombre    String

  // Relaciones -----
  estado             estados               @relation(fields: [estado_id], references: [id], onDelete: Cascade)
  personasMunicipios personas_municipios[]
  sucursales         sucursales[]

  // Restricciones -----
  @@unique([estado_id, clave])
}

model permisos {
  id            Int     @id @default(autoincrement())
  nombre        String  @unique
  descripcion   String
  identificador String  @unique
  asignable     Boolean

  // Relaciones -----
  rolesPermisos    roles_permisos[]
  usuariosPermisos usuarios_permisos[]
}

model medios {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  // Relaciones -----
  contactos contactos[]
}

model trabajos {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  // Relaciones -----
  asignaciones asignaciones[]
}

model estatus_asignaciones {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  // Relaciones -----
  asignaciones asignaciones[]
}

model estatus_honorarios {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

//---------- Personas ----------
model personas {
  id               Int       @id @default(autoincrement())
  alias            String
  nombre           String
  apellido_paterno String?
  apellido_materno String?
  fecha_nacimiento DateTime?

  // Relaciones -----
  contactos contactos[]
  cobertura personas_municipios[]
  usuarios  usuarios?

  // Restricciones -----
  @@unique([alias, nombre, apellido_paterno, apellido_materno])
}

model contactos {
  id         Int    @id @default(autoincrement())
  medio_id   Int
  persona_id Int
  valor      String

  // Relaciones -----
  medio   medios   @relation(fields: [medio_id], references: [id])
  persona personas @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  // Restricciones -----
  @@unique([medio_id, persona_id, valor])
  @@index([persona_id])
}

model personas_municipios {
  id           Int @id @default(autoincrement())
  persona_id   Int
  municipio_id Int

  // Relaciones -----
  municipio municipios @relation(fields: [municipio_id], references: [id], onDelete: Restrict)
  persona   personas   @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  // Restricciones -----
  @@unique([persona_id, municipio_id])
  @@index([municipio_id])
}

//---------- Usuarios ----------
model usuarios {
  id            Int       @id @default(autoincrement())
  persona_id    Int       @unique
  rol_id        Int
  correo        String    @unique
  contrasena    String
  fecha_acceso  DateTime?
  refresh_token String?

  // Relaciones -----
  rol     roles    @relation(fields: [rol_id], references: [id], onDelete: Restrict)
  persona personas @relation(fields: [persona_id], references: [id], onDelete: Restrict)

  permisos                 usuarios_permisos[]
  asignaciones_responsable asignaciones[]      @relation("responsable")
  asignaciones_asignado    asignaciones[]      @relation("asignado")

  // Restricciones -----
  @@index([rol_id])
}

model usuarios_permisos {
  id         Int @id @default(autoincrement())
  usuario_id Int
  permiso_id Int

  // Relaciones -----
  usuario usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  permiso permisos @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  // Restricciones -----
  @@unique([usuario_id, permiso_id])
  @@index([permiso_id])
}

model roles {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  asignable Boolean

  // Relaciones -----
  permisos roles_permisos[]
  usuarios usuarios[]
}

model roles_permisos {
  id         Int @id @default(autoincrement())
  permiso_id Int
  rol_id     Int

  // Relaciones -----
  rol     roles    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permiso permisos @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  // Restricciones -----
  @@unique([permiso_id, rol_id])
  @@index([rol_id])
}

//---------- Sucursales ----------
model clientes {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  // Relaciones -----
  identificadores identificadores[]
  sucursales      sucursales[]
}

model identificadores {
  id         Int    @id @default(autoincrement())
  cliente_id Int
  nombre     String

  // Relaciones -----
  cliente clientes @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  claves  claves[]

  // Restricciones -----
  @@unique([cliente_id, nombre])
}

model sucursales {
  id              Int     @id @default(autoincrement())
  municipio_id    Int
  cliente_id      Int
  nombre          String
  direccion       String?
  clave_signature String

  // Relaciones -----
  municipio municipios @relation(fields: [municipio_id], references: [id], onDelete: Restrict)
  cliente   clientes   @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  claves       claves[]
  asignaciones asignaciones[]

  // Restricciones -----
  @@unique([cliente_id, clave_signature])
}

model claves {
  id               Int    @id @default(autoincrement())
  sucursal_id      Int
  identificador_id Int
  valor            String

  // Relaciones -----
  identificador identificadores @relation(fields: [identificador_id], references: [id], onDelete: Restrict)
  sucursal      sucursales      @relation(fields: [sucursal_id], references: [id], onDelete: Cascade)

  // Restricciones -----
  @@unique([sucursal_id, identificador_id])
}

//---------- Asignaciones ----------
model asignaciones {
  id                     Int       @id @default(autoincrement())
  usuario_responsable_id Int
  usuario_asignado_id    Int
  trabajo_id             Int
  sucursal_id            Int
  estatus_asignacion_id  Int
  fecha_asignacion       DateTime
  fecha_completado       DateTime?

  // Relaciones -----
  trabajo             trabajos             @relation(fields: [trabajo_id], references: [id], onDelete: Restrict)
  estatus_asignacion  estatus_asignaciones @relation(fields: [estatus_asignacion_id], references: [id], onDelete: Restrict)
  sucursal            sucursales           @relation(fields: [sucursal_id], references: [id])
  usuario_responsable usuarios             @relation("responsable", fields: [usuario_responsable_id], references: [id])
  usuario_asignado    usuarios             @relation("asignado", fields: [usuario_asignado_id], references: [id])

  // Restricciones -----
  @@unique([sucursal_id, trabajo_id])
}
