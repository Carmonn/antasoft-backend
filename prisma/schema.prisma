datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

//---------- Catalogos ----------
model estados {
  id          Int    @id @default(autoincrement())
  clave       Int    @unique
  nombre      String @unique
  abreviatura String

  // Relaciones -----
  municipios municipios[]
}

model municipios {
  id        Int    @id @default(autoincrement())
  estado_id Int
  clave     Int
  nombre    String

  // Relaciones -----
  estado             estados               @relation(fields: [estado_id], references: [id], onDelete: Cascade)
  personasMunicipios personas_municipios[]

  // Restricciones -----
  @@unique([estado_id, clave])
}

model permisos {
  id            Int     @id @default(autoincrement())
  nombre        String  @unique
  descripcion   String
  identificador String  @unique
  asignable     Boolean
}

model medios {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  contactos contactos[]
}

//---------- Personas ----------
model personas {
  id               Int       @id @default(autoincrement())
  alias            String
  nombre           String
  apellido_paterno String?
  apellido_materno String?
  fecha_nacimiento DateTime?

  contactos contactos[]
  cobertura personas_municipios[]

  @@unique([alias, nombre, apellido_paterno, apellido_materno])
}

model contactos {
  id         Int    @id @default(autoincrement())
  medio_id   Int
  persona_id Int
  valor      String

  medio   medios   @relation(fields: [medio_id], references: [id])
  persona personas @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  @@unique([medio_id, persona_id, valor])
  @@index([persona_id])
}

model personas_municipios {
  id           Int @id @default(autoincrement())
  persona_id   Int
  municipio_id Int

  municipio municipios @relation(fields: [municipio_id], references: [id])
  persona   personas   @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  @@unique([persona_id, municipio_id])
  @@index([municipio_id])
}
